<Application x:Class="Compositor.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#25272C"/>
    <SolidColorBrush x:Key="Ink" Color="#ECEEF2"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#1C1E22"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#393D46"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#515661"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#191B20"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#4A4E58"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#191B20"/></Style>
    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Padding" Value="10,6"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="#B9BDC7"/></Style>
  </Application.Resources>
</Application>
