<Window x:Class="Compositor.App.ExposureWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exposure adjustment layer" Style="{StaticResource {x:Type Window}}" Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18">
    <TextBlock Text="EXPOSURE" FontWeight="SemiBold" Margin="3,0,3,10"/>
    <TextBlock Text="Adjusts the visible composite below this layer. Source images stay unchanged. Settings remain editable after saving." Foreground="#B9BDC7" TextWrapping="Wrap" Margin="3,0,3,10"/>
    <Label Content="Exposure (stops, -20 to 20)"/><TextBox x:Name="ExposureValue" Text="0" TextChanged="ValueChanged"/>
    <Label Content="Offset (linear light, -0.5 to 0.5)"/><TextBox x:Name="OffsetValue" Text="0" TextChanged="ValueChanged"/>
    <Label Content="Gamma (0.01 to 9.99)"/><TextBox x:Name="GammaValue" Text="1" TextChanged="ValueChanged"/>
    <CheckBox x:Name="PreviewEnabled" Content="Preview changes" IsChecked="True" Foreground="White" Margin="6,14,6,4" Click="TogglePreview"/>
    <TextBlock x:Name="Feedback" Text="Ready" TextWrapping="Wrap" Foreground="#B9BDC7" Margin="6" MinHeight="36"/>
    <WrapPanel HorizontalAlignment="Right"><Button Content="Reset" Click="Reset"/><Button Content="Cancel" IsCancel="True"/><Button Content="Apply" IsDefault="True" Click="Apply"/></WrapPanel>
  </StackPanel>
</Window>
