<Window x:Class="Compositor.App.ColorOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color overlay effect" Style="{StaticResource {x:Type Window}}" Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18">
    <TextBlock Text="COLOR OVERLAY" FontWeight="SemiBold" Margin="3,0,3,10"/>
    <TextBlock Text="Adds color over this layer after its mask. Soft edges can become more opaque. Source pixels stay unchanged." Foreground="#B9BDC7" TextWrapping="Wrap" Margin="3,0,3,10"/>
    <CheckBox x:Name="EffectEnabled" Content="Effect enabled" IsChecked="True" Foreground="White" Margin="6" Click="TogglePreview"/>
    <Border x:Name="ColorSwatch" Height="36" Margin="5" BorderBrush="#808080" BorderThickness="1"/>
    <Label Content="Red (0 to 1)"/><TextBox x:Name="RedValue" Text="1" TextChanged="ValueChanged"/>
    <Label Content="Green (0 to 1)"/><TextBox x:Name="GreenValue" Text="1" TextChanged="ValueChanged"/>
    <Label Content="Blue (0 to 1)"/><TextBox x:Name="BlueValue" Text="1" TextChanged="ValueChanged"/>
    <Label Content="Effect opacity (0 to 1)"/><TextBox x:Name="OpacityValue" Text="1" TextChanged="ValueChanged"/>
    <CheckBox x:Name="PreviewEnabled" Content="Preview changes" IsChecked="True" Foreground="White" Margin="6,14,6,4" Click="TogglePreview"/>
    <TextBlock x:Name="Feedback" Text="Ready" TextWrapping="Wrap" Foreground="#B9BDC7" Margin="6" MinHeight="36"/>
    <WrapPanel><Button x:Name="ResetButton" Content="Reset to white" Click="Reset"/><Button x:Name="RemoveButton" Content="Remove effect" Click="Remove"/></WrapPanel>
    <WrapPanel HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True"/><Button Content="Apply" IsDefault="True" Click="Apply"/></WrapPanel>
  </StackPanel>
</Window>
