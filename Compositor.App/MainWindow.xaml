<Window x:Class="Compositor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Compositor.App"
        Title="Compositor for Windows" Width="1320" Height="860" MinWidth="1000" MinHeight="650" AllowDrop="True" Drop="DropFiles" Closing="WindowClosing" PreviewKeyDown="WindowKeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#25272C" Padding="12,8"><TextBlock x:Name="Status" Text="Ready" Foreground="#B9BDC7"/></Border>
    <Grid x:Name="Editor">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Menu Background="#E7E9ED" Foreground="#22252C">
        <MenuItem Header="_File">
          <MenuItem Header="_New canvas…" InputGestureText="Ctrl+N" Click="NewDocument"/>
          <MenuItem Header="_Open project folder…" InputGestureText="Ctrl+O" Click="OpenProject"/>
          <MenuItem Header="Open _recovery copy…" Click="OpenRecovery"/>
          <MenuItem Header="_Import images…" InputGestureText="Ctrl+I" Click="ImportImages"/>
          <Separator/><MenuItem Header="_Save project" InputGestureText="Ctrl+S" Click="SaveProject"/><MenuItem Header="Save project _as…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs"/>
          <Separator/><MenuItem Header="Export _PNG…" Click="ExportPng"/><MenuItem Header="Export _JPEG…" Click="ExportJpeg"/>
        </MenuItem>
        <MenuItem Header="_Edit"><MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo"/><MenuItem x:Name="RedoMenu" Header="_Redo" InputGestureText="Ctrl+Shift+Z" Click="Redo"/></MenuItem>
        <MenuItem Header="_Image"><MenuItem x:Name="AdjustColorsMenu" Header="Adjust _colors…" Click="AdjustColors"/><Separator/><MenuItem Header="New _Exposure adjustment layer…" Click="AddExposure"/><MenuItem x:Name="EditExposureMenu" Header="_Edit Exposure…" Click="EditExposure"/><Separator/><MenuItem Header="New _Levels adjustment layer…" Click="AddLevels"/><MenuItem x:Name="EditLevelsMenu" Header="Edit Levels…" Click="EditLevels"/><Separator/><MenuItem Header="New Curves adjustment layer…" Click="AddCurves"/><MenuItem x:Name="EditCurvesMenu" Header="Edit Curves…" Click="EditCurves"/></MenuItem>
        <MenuItem Header="Effe_cts"><MenuItem x:Name="ColorOverlayMenu" Header="_Color overlay…" Click="EditColorOverlay"/></MenuItem>
        <MenuItem Header="_View"><MenuItem Header="_Fit canvas" InputGestureText="Ctrl+0" Click="Fit"/><MenuItem Header="_Actual pixels" InputGestureText="Ctrl+1" Click="ActualPixels"/></MenuItem>
      </Menu>
      <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="10,8" BorderBrush="#424650" BorderThickness="0,0,0,1">
        <Border.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style></Border.Resources>
        <StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <TextBlock Text="COMPOSITOR" FontWeight="Bold" Margin="5,0,20,0"/>
            <ListBox x:Name="ToolPicker" SelectedIndex="1" SelectionChanged="ToolChanged" Background="Transparent" BorderThickness="0" Margin="0,0,16,0" AutomationProperties.Name="Editing tool">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#ECEEF2"/><Setter Property="Background" Value="#333740"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="2"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="ToolBorder" Background="{TemplateBinding Background}" BorderBrush="#555B66" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ToolBorder" Property="Background" Value="#23574F"/><Setter TargetName="ToolBorder" Property="BorderBrush" Value="#62C9B5"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToolBorder" Property="BorderBrush" Value="White"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ToolBorder" Property="BorderBrush" Value="White"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
              </Style></ListBox.ItemContainerStyle>
              <ListBoxItem Content="Move  V" ToolTip="Move the selected layer (V)"/>
              <ListBoxItem Content="Brush  B" ToolTip="Paint (B)"/>
              <ListBoxItem Content="Eraser  E" ToolTip="Erase pixels (E)"/>
              <ListBoxItem Content="Hand  H" ToolTip="Pan the canvas (H)"/>
            </ListBox>
            <Button Content="Fit" Click="Fit" ToolTip="Fit canvas (Ctrl+0)"/>
            <Button Content="100%" Click="ActualPixels" ToolTip="Actual pixels (Ctrl+1)"/>
            <TextBlock x:Name="ToolHint" Foreground="#B9BDC7" Margin="14,0,4,0" Text="Wheel: zoom · Middle drag: pan"/>
          </WrapPanel>
          <WrapPanel x:Name="BrushOptions" Margin="0,8,0,0">
            <StackPanel Width="190" Margin="5,0,14,0"><DockPanel><TextBlock Text="Size"/><TextBlock Text="px" DockPanel.Dock="Right"/><TextBox x:Name="BrushSize" Text="40" Width="60" AutomationProperties.Name="Brush Size"/></DockPanel><Slider Style="{StaticResource EditorSlider}" x:Name="SizeSlider" Minimum="1" Maximum="2000" Value="40" SmallChange="1" LargeChange="10" AutomationProperties.Name="Brush Size slider"/></StackPanel>
<StackPanel Width="170" Margin="5,0,14,0"><DockPanel><TextBlock Text="Hardness"/><TextBlock Text="%" DockPanel.Dock="Right"/><TextBox x:Name="BrushHardness" Text="70" Width="60" AutomationProperties.Name="Brush Hardness"/></DockPanel><Slider Style="{StaticResource EditorSlider}" x:Name="HardnessSlider" Minimum="0" Maximum="100" Value="70" SmallChange="1" LargeChange="10" AutomationProperties.Name="Brush Hardness slider"/></StackPanel>
<StackPanel Width="170" Margin="5,0,14,0"><DockPanel><TextBlock Text="Opacity"/><TextBlock Text="%" DockPanel.Dock="Right"/><TextBox x:Name="BrushOpacity" Text="100" Width="60" AutomationProperties.Name="Brush Opacity"/></DockPanel><Slider Style="{StaticResource EditorSlider}" x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" SmallChange="1" LargeChange="10" AutomationProperties.Name="Brush Opacity slider"/></StackPanel>
            <StackPanel x:Name="ColorOptions" Margin="5,0,14,0">
              <TextBlock Text="Foreground color" Foreground="#B9BDC7" Margin="3,0,0,2"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ColorButton" Click="PickBrushColor" Padding="3" Width="46" Height="31" ToolTip="Choose foreground color" AutomationProperties.Name="Choose foreground color"><Border x:Name="ColorSwatch" Width="30" Height="19" Background="#62C9B5" BorderBrush="White" BorderThickness="1"/></Button>
                <TextBox x:Name="BrushColor" Text="#62C9B5" Width="88" ToolTip="RGB hex color" AutomationProperties.Name="Foreground hex color"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="MaskOptions" Width="225" Visibility="Collapsed">
              <DockPanel><TextBlock Text="Mask gray"/><TextBlock Text="%" DockPanel.Dock="Right"/><TextBox x:Name="MaskGray" Text="100" Width="50" IsEnabled="False" AutomationProperties.Name="Mask gray"/></DockPanel>
              <Slider Style="{StaticResource EditorSlider}" x:Name="MaskSlider" Minimum="0" Maximum="100" Value="100" AutomationProperties.Name="Mask gray slider"/>
              <StackPanel Orientation="Horizontal"><Button Content="Black · Hide" Click="MaskBlack" Padding="6,2"/><Button Content="White · Reveal" Click="MaskWhite" Padding="6,2"/></StackPanel>
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <local:EditorCanvas x:Name="Canvas" Focusable="True"/>
        <Border Grid.Column="1" Background="{StaticResource Panel}" Padding="10" BorderBrush="#424650" BorderThickness="1,0,0,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <StackPanel>
              <TextBlock Text="LAYER PROPERTIES" FontWeight="SemiBold" Foreground="#B9BDC7" Margin="5,6,0,12"/>
              <TextBox x:Name="LayerName" ToolTip="Layer name"/>
              <CheckBox x:Name="LayerVisible" Content="Visible" Foreground="White" Margin="6"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="Opacity %"/><TextBox x:Name="LayerOpacity" Text="100"/></StackPanel>
                <StackPanel Grid.Column="1"><Label Content="Blend mode"/><ComboBox x:Name="LayerBlend"/></StackPanel>
              </Grid>
              <Expander x:Name="TransformPanel" Header="Position, size and rotation" Foreground="White" Margin="5,8,5,0">
              <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><Label Content="X"/><TextBox x:Name="LayerX"/><Label Content="Width"/><TextBox x:Name="LayerWidth"/></StackPanel>
                <StackPanel Grid.Column="1"><Label Content="Y"/><TextBox x:Name="LayerY"/><Label Content="Height"/><TextBox x:Name="LayerHeight"/></StackPanel>
              </Grid>
              <Label Content="Rotation (clockwise degrees)"/><TextBox x:Name="LayerRotation"/>
              <WrapPanel><CheckBox x:Name="FlipX" Content="Flip X" Foreground="White" Margin="6"/><CheckBox x:Name="FlipY" Content="Flip Y" Foreground="White" Margin="6"/></WrapPanel>
              <ComboBox x:Name="LayerSampling" ToolTip="Image resampling"/>
              </StackPanel>
              </Expander>
              <Button Content="Apply layer properties" Click="ApplyLayer"/>
              <Button x:Name="AdjustColorsButton" Content="Adjust image colors…" Click="AdjustColors" ToolTip="Brightness, contrast and saturation; select Edit image to adjust source pixels"/>
              <Button x:Name="EditExposureButton" Content="Edit Exposure…" Click="EditExposure" Visibility="Collapsed"/>
              <Button x:Name="EditLevelsButton" Content="Edit Levels…" Click="EditLevels" Visibility="Collapsed"/>
              <Button x:Name="EditCurvesButton" Content="Edit Curves…" Click="EditCurves" Visibility="Collapsed"/>
              <TextBlock x:Name="ExposureHint" Text="Live adjustment of everything below. Paint its mask to limit coverage; transforms affect only the mask." Foreground="#B9BDC7" TextWrapping="Wrap" Margin="5" Visibility="Collapsed"/>
              <Button x:Name="ColorOverlayButton" Content="Color overlay…" Click="EditColorOverlay"/>
              <TextBlock x:Name="ColorOverlayInfo" Foreground="#B9BDC7" Margin="5"/>
              <TextBlock x:Name="GroupHint" Text="Group opacity multiplies into each child. Use Move to move all children; select a child to paint or transform." TextWrapping="Wrap" Foreground="#9DA3AF" Margin="5" Visibility="Collapsed"/>
              <Expander x:Name="MaskSection" Header="LAYER MASK" Foreground="White" Margin="5,10,0,5"><StackPanel>
              <TextBlock x:Name="MaskInfo" Text="No mask" Foreground="#B9BDC7" Margin="5"/>
              <WrapPanel><Button x:Name="RevealMaskButton" Content="+ Reveal" Click="AddRevealMask"/><Button x:Name="HideMaskButton" Content="+ Hide" Click="AddHideMask"/><Button x:Name="RemoveMaskButton" Content="Remove" Click="RemoveMask"/></WrapPanel>
              <CheckBox x:Name="MaskEnabled" Content="Mask enabled" Foreground="White" Margin="6" Click="ToggleMask"/>
              <ComboBox x:Name="EditTarget" SelectedIndex="0" SelectionChanged="EditTargetChanged" ToolTip="Choose what the brush and eraser edit"><ComboBoxItem Content="Edit image"/><ComboBoxItem Content="Edit mask"/></ComboBox>
              <TextBlock Text="Linked to layer · Brush gray: 0 hides, 100 reveals · Eraser hides" TextWrapping="Wrap" Foreground="#9DA3AF" Margin="5"/>
              </StackPanel></Expander>
              <TextBlock Text="LAYERS" FontWeight="SemiBold" Foreground="#B9BDC7" Margin="5,18,0,8"/>
              <WrapPanel><Button Content="+" ToolTip="New blank layer" Click="AddLayer"/><Button Content="−" ToolTip="Delete selected layer or group and its children" Click="DeleteLayer"/><Button Content="↑" ToolTip="Move layer up" Click="LayerUp"/><Button Content="↓" ToolTip="Move layer down" Click="LayerDown"/></WrapPanel>
              <WrapPanel><Button Content="+ Group" Click="AddGroup" ToolTip="New empty group"/><Button x:Name="WrapGroupButton" Content="Group" Click="WrapInGroup" ToolTip="Wrap the selected layer or group"/><Button x:Name="UngroupButton" Content="Ungroup" Click="Ungroup" ToolTip="Keep children and preserve group appearance"/></WrapPanel>
              <Expander Header="Move into a group" Foreground="White" Margin="5"><StackPanel>
                <ComboBox x:Name="ParentGroup" DisplayMemberPath="Label"/>
                <WrapPanel><Button x:Name="MoveToGroupButton" Content="Move here" Click="MoveToGroup"/><Button x:Name="MoveOutButton" Content="Move out" Click="MoveOutOfGroup"/></WrapPanel>
              </StackPanel></Expander>
            </StackPanel>
            <ListBox x:Name="Layers" Background="#191B20" Foreground="White" BorderThickness="0" MinHeight="140" MaxHeight="300" SelectionChanged="LayerSelected" Margin="3,8,3,3">
              <ListBox.ItemTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}" Opacity="{Binding RowOpacity}">
                  <Button Content="{Binding Disclosure}" IsEnabled="{Binding CanExpand}" Visibility="{Binding ExpandVisibility}" Tag="{Binding Id}" Click="ToggleGroup" Width="22" Padding="0" Margin="0,1,4,1"/>
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                </StackPanel>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
