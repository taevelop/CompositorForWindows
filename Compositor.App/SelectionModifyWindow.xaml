<Window x:Class="Compositor.App.SelectionModifyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
 Style="{StaticResource {x:Type Window}}" Title="Modify selection" Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
 <StackPanel Margin="18">
  <TextBlock x:Name="Heading" Foreground="{StaticResource Ink}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <DockPanel><TextBlock Text="Radius (pixels)" Foreground="{StaticResource Ink}"/><TextBox x:Name="AmountText" Text="1" Width="70" HorizontalAlignment="Right" LostKeyboardFocus="CommitAmount" KeyDown="AmountKeyDown" AutomationProperties.Name="Selection radius"/></DockPanel>
  <Slider x:Name="Amount" Minimum="0" Maximum="250" Value="1" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource EditorSlider}" ValueChanged="AmountChanged" AutomationProperties.Name="Selection radius slider"/>
  <Border Background="#111317" BorderBrush="{StaticResource Divider}" BorderThickness="1" Margin="0,12,0,4"><skia:SKElement x:Name="Preview" Height="210" PaintSurface="PaintPreview"/></Border>
  <TextBlock Text="White selects · Black excludes · Gray softens the edge" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,0,0,10"/>
  <CheckBox x:Name="ShowPreview" Content="Preview on canvas" Foreground="{StaticResource Ink}" IsChecked="True" Click="TogglePreview"/>
  <TextBlock x:Name="PreviewStatus" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" Margin="0,10,0,10"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" IsCancel="True" Click="CancelClicked" Style="{StaticResource CompactButton}"/>
   <Button x:Name="ApplyButton" Content="Apply" IsDefault="True" Click="ApplyClicked" Style="{StaticResource CompactButton}"/>
  </StackPanel>
 </StackPanel>
</Window>
